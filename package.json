{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1"
  },
  "toolVersions": {
    "gitleaks": "8.30.1"
  },
  "scripts": {
    "prepare": "husky",
    "check-env": "node scripts/doctor.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css,sol}\"",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:new": "node scripts/db-new.mjs",
    "db:migrate": "docker compose --env-file .env -f infra/docker-compose.yml run --rm flyway migrate",
    "db:info": "docker compose --env-file .env -f infra/docker-compose.yml run --rm flyway info",
    "db:validate": "docker compose --env-file .env -f infra/docker-compose.yml run --rm flyway validate",
    "deploy:build": "pnpm be:build && docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.deploy.yml build",
    "deploy:up": "pnpm db:migrate && docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.deploy.yml up -d",
    "deploy:down": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.deploy.yml stop issuer broker mts",
    "deploy:ps": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.deploy.yml ps",
    "deploy:logs": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.deploy.yml logs -f issuer broker mts",
    "fe:dev": "pnpm --filter \"./frontend/*\" --parallel run dev",
    "fe:lint": "pnpm --filter \"./frontend/*\" run lint",
    "fe:typecheck": "pnpm --filter \"./frontend/*\" run typecheck",
    "fe:build": "pnpm --filter \"./frontend/*\" run build",
    "be:issuer:run": "node scripts/backend-run.mjs issuer",
    "be:broker:run": "node scripts/backend-run.mjs broker",
    "be:mts:run": "node scripts/backend-run.mjs mts",
    "be:issuer:build": "node scripts/gradle.mjs :issuer:build",
    "be:broker:build": "node scripts/gradle.mjs :broker:build",
    "be:mts:build": "node scripts/gradle.mjs :mts:build",
    "be:build": "node scripts/gradle.mjs build",
    "be:clean": "node scripts/gradle.mjs clean",
    "be:test": "node scripts/gradle.mjs :issuer:test :broker:test :mts:test",
    "be:lint": "node scripts/gradle.mjs :issuer:spotlessCheck :broker:spotlessCheck :mts:spotlessCheck",
    "be:format": "node scripts/gradle.mjs :issuer:spotlessApply :broker:spotlessApply :mts:spotlessApply",
    "ct:compile": "pnpm --filter ./contracts compile",
    "ct:test": "pnpm --filter ./contracts test",
    "ct:lint": "pnpm --filter ./contracts lint",
    "ct:sign": "node scripts/sepolia-account.mjs sign",
    "ct:account": "node scripts/sepolia-account.mjs",
    "ct:rpc": "node scripts/sepolia-check.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@inquirer/password": "5.3.1",
    "ethers": "6.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-solidity": "^2.4.1"
  }
}
